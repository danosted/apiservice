{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apiservice-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static UI from ./dist (built by Vite). Only these paths reach the Worker;
  // unknown paths fall back to index.html so deep links work.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/__dev/*"]
  },

  // Top level = local dev. Fakes are refused unless ENVIRONMENT is "local",
  // and the fake identity only answers on localhost.
  "vars": {
    "ENVIRONMENT": "local",
    "IDENTITY": "fake", // fake | access
    "GAME_BACKEND": "binding", // binding | fake (in-memory seed data, no game service needed)
    "AUDIT_BACKEND": "d1" // d1 | memory
  },
  "d1_databases": [{ "binding": "DB", "database_name": "admin-db", "database_id": "REPLACE_WITH_ADMIN_DB_ID" }],
  "services": [{ "binding": "GAME", "service": "apiservice-game", "entrypoint": "GameRpc" }],

  "env": {
    // Deploy with `npm run deploy -w services/admin`, which selects this environment.
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "IDENTITY": "access",
        "GAME_BACKEND": "binding",
        "AUDIT_BACKEND": "d1",
        "ACCESS_TEAM_DOMAIN": "https://mikkelsted.cloudflareaccess.com",
        "ACCESS_AUD": "5fc76cf965d9913ca9acbc213f63d1c0c966381fb2d4dc059fd920c85e9bba61",
        "EDITOR_EMAILS": "danosted@gmail.com"
      },
      "routes": [{ "pattern": "admin.mikkelsted.dk", "custom_domain": true }],
      "workers_dev": false,
      "d1_databases": [
        { "binding": "DB", "database_name": "admin-db", "database_id": "6a9f75a5-8c83-4120-8a4b-4eb7e14a23f1" }
      ],
      "services": [{ "binding": "GAME", "service": "apiservice-game", "entrypoint": "GameRpc" }]
    }
  }
}
