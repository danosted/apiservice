{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apiservice-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Create with `npx wrangler d1 create apiservice-db`, then paste the id here.
  // The placeholder id doubles as the local database key, so keep it unique per service.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apiservice-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
